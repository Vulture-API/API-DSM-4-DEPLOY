{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendSSMCommandToVultureEC2",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:<AWS_REGION>:<AWS_ACCOUNT_ID>:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "vulture"
        }
      }
    },
    {
      "Sid": "AllowRunShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:<AWS_REGION>::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadSSMCommandStatusAndDescribeInstances",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
